# Node.js
# =================================
# The node_modules folder contains all downloaded dependencies.
# It can be huge and is fully reproducible with `npm install`.
/desktop-app/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Python
# =================================
# The virtual environment folder.
.venv
venv
env

# Python cache files
__pycache__/
*.py[cod]
*$py.class


# Application Build Output
# =================================
# IGNORE the large unpacked build folder and debug files inside dist.
# DO NOT ignore the installer .exe file.
/desktop-app/dist/win-unpacked/
/desktop-app/dist/builder-*.yml


# Data Files
# =================================
# These are the large, generated data files. The source of truth is the
# raw .parquet files and the processing scripts, not these JSON outputs.
/backend/data/

# The entire workspace folder contains raw data, notebooks, and other
# intermediate files not part of the final application source code.
/workspace/


# User-specific Files
# =================================
# User-specific settings for editors like VS Code or JetBrains.
.vscode/
.idea/

# User-specific favorites file generated by the application at runtime.
# This is stored in AppData, but this rule prevents accidental commits if run locally.
favorites.json


# OS-specific files
# =================================
.DS_Store
Thumbs.db