{
  "name": "draftdiff",
  "version": "4.5.1",
  "description": "Real-time League of Legends draft analysis and recommendation tool.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:update-preview": "electron . --update-preview",
    "dist": "electron-builder --publish never"
  },
  "author": "Lytten",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.draftdiff.app",
    "productName": "DraftDiff",
    "artifactName": "DraftDiff-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Lydig",
      "repo": "deltadraft",
      "releaseType": "release"
    },
    "files": ["index.html", "main.js", "preload.js", "updater.js", "update-service.js", "update-ui.js", "assets/**/*"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
