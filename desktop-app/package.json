{
  "name": "draftdiff",
  "version": "4.6.0",
  "description": "Real-time League of Legends draft analysis and recommendation tool.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:update-preview": "electron . --update-preview",
    "dist": "electron-builder --publish never"
  },
  "author": "Lytten",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.draftdiff.app",
    "productName": "DraftDiff",
    "files": [
      "index.html", "main.js", "preload.js", "updates.js", "update-ui.js", "assets/**/*",
      { "from": "..", "to": ".", "filter": ["LICENSE", "THIRD_PARTY_NOTICES.md"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
