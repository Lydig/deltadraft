{
  "name": "deltadraft",
  "version": "1.1.0",
  "description": "League of Legends Champion Pick Recommender",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.deltadraft.app",
    "productName": "DeltaDraft",
    "files": [
      "**/*",
      "!*.code-workspace",
      "!LICENSE.md",
      "!package.json",
      "!package-lock.json",
      "!README.md"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}